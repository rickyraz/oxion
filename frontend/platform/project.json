{
  "name": "frontend-platform",
  "root": "frontend/platform",
  "projectType": "application",
  "tags": [
    "scope:frontend",
    "domain:platform",
    "lang:typescript",
    "type:frontend"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir frontend/platform run dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir frontend/platform run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir frontend/platform run test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir frontend/platform run lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir frontend/platform run typecheck"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir frontend/platform run generate"
      }
    }
  }
}

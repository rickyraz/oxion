{
  "name": "oxion_policy",
  "root": "packages/policy",
  "projectType": "library",
  "tags": [
    "scope:packages",
    "domain:policy",
    "lang:gleam",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/policy",
        "command": "gleam build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/policy",
        "command": "gleam test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/policy",
        "command": "gleam check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/policy",
        "command": "gleam format --check src test"
      }
    }
  }
}

{
  "id": "com.oxion.plugin.starter-ts",
  "name": "Starter TS Plugin",
  "version": "0.1.0",
  "api_version": "v1",
  "runtime": {
    "language": "typescript",
    "version": "5.x"
  },
  "type": "flow",
  "entrypoint": "main",
  "hooks": ["before_step"],
  "permissions": ["read:service", "write:workflow", "emit:event"],
  "tenant_scope": "tenant",
  "config_schema": {
    "type": "object",
    "properties": {
      "target_step": {
        "type": "string",
        "default": "activate_service"
      },
      "auto_allow": {
        "type": "boolean",
        "default": true
      }
    },
    "required": ["target_step", "auto_allow"]
  }
}

{
  "name": "oxion-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "nx run-many -t dev --all --parallel --exclude=oxion-workspace",
    "build": "nx run-many -t build --all --exclude=oxion-workspace",
    "test": "nx run-many -t test --all --exclude=oxion-workspace",
    "lint": "nx run oxion-workspace:boundaries && nx run-many -t lint --all --exclude=oxion-workspace",
    "typecheck": "nx run-many -t typecheck --all --exclude=oxion-workspace",
    "generate": "nx run oxion-workspace:generate && nx run-many -t generate --all --exclude=oxion-workspace",
    "generate:contracts": "node ./scripts/generate-contracts.mjs",
    "generate:zod": "node --experimental-strip-types ./scripts/generate-zod.ts",
    "harness:freeradius": "node ./scripts/run-oxradius-freeradius-harness.mjs",
    "check:generated": "pnpm run generate:contracts && pnpm run generate:zod && git diff --exit-code -- generated",
    "build:gleam": "nx run-many -t build --projects=oxion_policy,oxion_interop,oxcore,oxradius,oxnoc,oxolt,oxbgp",
    "test:gleam": "nx run-many -t test --projects=oxion_policy,oxion_interop,oxcore,oxradius,oxnoc,oxolt,oxbgp",
    "lint:gleam": "nx run-many -t lint --projects=oxion_policy,oxion_interop,oxcore,oxradius,oxnoc,oxolt,oxbgp",
    "typecheck:gleam": "nx run-many -t typecheck --projects=oxion_policy,oxion_interop,oxcore,oxradius,oxnoc,oxolt,oxbgp",
    "gleam:build": "pnpm run build:gleam",
    "gleam:test": "pnpm run test:gleam",
    "gleam:format:check": "pnpm run lint:gleam",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:check": "changeset status --verbose",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "nx": "^20.3.1"
  }
}

{
  "name": "oxacs",
  "root": "apps/oxacs",
  "projectType": "application",
  "tags": [
    "scope:apps",
    "domain:oxacs",
    "lang:gleam",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/oxacs",
        "command": "gleam build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/oxacs",
        "command": "gleam test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/oxacs",
        "command": "gleam check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/oxacs",
        "command": "gleam format --check src test"
      }
    }
  }
}

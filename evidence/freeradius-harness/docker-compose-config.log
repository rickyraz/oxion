name: freeradius
services:
  freeradius:
    command:
      - sh
      - -lc
      - ln -sf ../sites-available/coa /etc/freeradius/sites-enabled/coa && exec freeradius -X
    container_name: oxion-freeradius-harness
    image: freeradius/freeradius-server:3.2.3
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1812
        published: "1812"
        protocol: udp
      - mode: ingress
        target: 1813
        published: "1813"
        protocol: udp
      - mode: ingress
        target: 3799
        published: "3799"
        protocol: udp
    volumes:
      - type: bind
        source: /home/rickyraz/my_dream/oxion/apps/oxradius/test/harness/freeradius/config/clients.conf
        target: /etc/freeradius/clients.conf
        read_only: true
        bind: {}
networks:
  default:
    name: freeradius_default
